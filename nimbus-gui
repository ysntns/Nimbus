#!/usr/bin/env python3
"""
Nimbus GUI Launcher
Launch the CustomTkinter-based GUI application
"""

import os
import sys

# Add app directory to path
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "app"))

try:
    from app.gui.main_window_ctk import main

    main()
except ImportError as e:
    print(f"Error: {e}")
    print("\nMissing dependencies. Please install GUI requirements:")
    print("  pip install customtkinter pillow darkdetect")
    sys.exit(1)
except Exception as e:
    print(f"Error launching Nimbus GUI: {e}")
    import traceback

    traceback.print_exc()
    sys.exit(1)
